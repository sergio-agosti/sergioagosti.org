doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    block meta
      meta(
        name="description",
        content="Sergio Agosti - Open-source web developer specializing in accessible, high-performance websites and web applications"
      )
    block title
      title Sergio Agosti - Open-source Web Developer
    link(rel="stylesheet", href="/main.css")
    script.
      document.addEventListener("theme-change", (event) => {
        document.documentElement.classList.remove("dark", "light");
        document.documentElement.classList.toggle("dark", event.detail.theme === "dark");
        document.documentElement.classList.toggle("light", event.detail.theme === "light");
      });
      document.dispatchEvent(new CustomEvent("theme-change", { detail: { theme: localStorage.theme } }));
  body(
    class="transition **:transition-discrete",
    class="min-h-svh grid grid-rows-[auto_1fr_auto] gap-8 sm:gap-16",
    class="font-mono text-base leading-relaxed tracking-tight text-pretty",
    class="bg-gray-100 text-gray-900 dark:bg-gray-900 dark:text-gray-100"
  )
    block vars
      - var current = "index";
    include @/components/_topbar
    main(class="container self-center space-y-8 sm:space-y-16")
      header(class="space-y-2")
        block page-header
      block content
    unless current === "thank-you"
      include @/components/_contact-cta
