block vars
  - var current = "index";

doctype html
html(lang="en-GB", class="print:scheme-light")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    block meta
      meta(
        name="description",
        content="Sergio Agosti - Full-stack web developer specialising in accessible, high-performance websites and web applications"
      )
    block title
      title Sergio Agosti - Full-stack web developer
    link(rel="icon", href="/favicon.ico", sizes="32x32")
    link(rel="icon", href="/favicon.svg", type="image/svg+xml")
    link(rel="apple-touch-icon", href="/apple-touch-icon.png")
    link(rel="stylesheet", href="/main.css")
    script.
      document.addEventListener("theme-change", (event) => {
        document.documentElement.classList.remove("dark", "light");
        document.documentElement.classList.toggle("dark", event.detail.theme === "dark");
        document.documentElement.classList.toggle("light", event.detail.theme === "light");
      });
      document.dispatchEvent(new CustomEvent("theme-change", { detail: { theme: localStorage.theme } }));
  body(
    class="transition **:transition-discrete print:m-[2cm]",
    class="grid min-h-svh grid-rows-[auto_1fr_auto] gap-8 sm:gap-16 print:min-h-0 print:gap-4",
    class="font-mono text-base tracking-tight text-pretty print:text-[9pt] print:leading-tight",
    class="not-print:bg-gray-100 text-gray-900 dark:bg-gray-900 dark:text-gray-100",
  )
    include @/components/_topbar
    main(
      class="container space-y-8 self-center sm:space-y-16 print:space-y-5",
      class=current === "cv" ? "print:max-w-none print:px-0" : undefined
    )
      header
        block page-header
      block content
    unless current === "thank-you"
      include @/components/_contact-cta
