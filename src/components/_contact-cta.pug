//- The pill sticks to the bottom of the viewport while the page scrolls, so the
//- footer is left transparent to clicks and only the pill itself takes them.
footer(class="container pointer-events-none sticky bottom-2")
  p(
    class="pointer-events-auto -mx-2 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center",
    class="rounded-4xl border glow-border bg-gray-100/70 px-5 py-3 glow backdrop-blur dark:bg-gray-900/70"
  )
    | Available for work.
    button(class="button", commandfor="contact-dialog", command="show-modal") Contact me
dialog#contact-dialog(
  class="m-auto w-lg rounded border glow-border bg-gray-100 text-inherit glow transition not-open:opacity-0 dark:bg-gray-900 starting:opacity-0",
  class="backdrop:bg-black/50 backdrop:backdrop-blur-xs backdrop:transition not-open:backdrop:opacity-0 starting:backdrop:opacity-0"
)
  div(class="p-4 sm:px-8 sm:py-6")
    form(method="dialog", class="flex justify-end")
      button(
        class="flex rounded p-1 text-gray-600 transition hover:bg-gray-200 hover:text-current dark:text-gray-400 dark:hover:bg-gray-800"
      )
        svg(class="size-5 fill-none stroke-current", viewBox="0 0 24 24")
          title Close
          path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M6 18L18 6M6 6l12 12")
    include @/components/_contact.pug
