extends @/templates/_layout.pug

block vars
  - var current = "projects";

block meta
  meta(
    name="description",
    content="Projects by Sergio Agosti: an agentic CMS built with Astro and SolidJS, client work across insurance, manufacturing and e-commerce, plus personal and open-source projects."
  )

block title
  title Sergio Agosti - Projects

mixin tags(list)
  ul(class="flex flex-wrap gap-2")
    each tag in list
      li(class="rounded bg-teal-300 px-2 py-0.5 text-xs text-gray-900 dark:bg-teal-100")= tag

mixin links(list)
  if list && list.length
    ul(class="flex flex-wrap gap-x-4 gap-y-1 text-sm")
      each link in list
        li
          a(
            href=link.url,
            class="text-teal-600 underline decoration-teal-600/40 underline-offset-4 transition hover:decoration-current dark:text-teal-400"
          )= link.label

mixin project(project, options)
  -
    const featured = Boolean(options && options.featured)
    const hasLink = Boolean(project.links && project.links.length)
    const href = hasLink ? project.links[0].url : null
    const linkClass = hasLink
      ? "text-teal-600 dark:text-teal-400 underline decoration-teal-600/40 underline-offset-4 transition hover:decoration-current"
      : false
    const articleClass = featured
      ? "grid gap-2 border-l-4 border-teal-400 pl-4 sm:pl-6"
      : "grid gap-2"
    const titleClass = featured ? "text-xl font-semibold" : "font-semibold"
  article(class=articleClass)
    h3(class=titleClass)
      if href
        a(href=href, class=linkClass)= project.title
      else
        = project.title
    p(class="text-sm text-gray-600 dark:text-gray-400")= project.subtitle
    p= project.summary
    if project.highlights
      ul(class="list-disc space-y-1 pl-5")
        each point in project.highlights
          li= point
    if project.role
      p(class="text-sm text-gray-600 dark:text-gray-400")
        strong(class="font-semibold text-gray-900 dark:text-gray-100") Role:
        = " " + project.role
    p(class="text-sm text-gray-600 dark:text-gray-400")= project.era
    +tags(project.stack)
    if featured
      p(class="text-sm font-semibold text-teal-600 dark:text-teal-400")
        if project.cta
          = project.cta
        else
          | NDA: details available in person
    +links(project.links)

block content
  header(class="container my-8 space-y-2 sm:my-16")
    h1(class="-ml-1 text-4xl tracking-tighter text-teal-600 transition dark:text-teal-400") Projects
    p(class="text-lg") Selected work – own platforms, client builds and personal projects
  main(class="container my-8 space-y-8 sm:my-16 sm:space-y-16")
    section(aria-labelledby="featured-heading", class="space-y-4")
      h2#featured-heading(class="text-2xl font-semibold tracking-tight") Featured
      div(class="space-y-8")
        each project in PROJECTS.featured
          +project(project, { featured: true })
    section(aria-labelledby="client-heading", class="space-y-4")
      h2#client-heading(class="text-2xl font-semibold tracking-tight") Client work
      p(class="text-sm text-gray-600 dark:text-gray-400") Built while leading development at #[a(href="https://theframeworks.com", class="text-teal-600 underline decoration-teal-600/40 underline-offset-4 transition hover:decoration-current dark:text-teal-400") The Frameworks]. Most of this work is under NDA, so projects are described generically – specifics are available in person.
      div(class="space-y-8")
        each project in PROJECTS.client
          +project(project)
    section(aria-labelledby="personal-heading", class="space-y-4")
      h2#personal-heading(class="text-2xl font-semibold tracking-tight") Personal projects
      div(class="space-y-8")
        each project in PROJECTS.personal
          +project(project)
    section(aria-labelledby="contact-heading", class="space-y-4")
      h2#contact-heading(class="sr-only") Contact
      p I'm available for projects and collaboration.
        button(class="button", commandfor="contact-dialog", command="show-modal") Contact me
      dialog#contact-dialog(
        class="m-auto w-lg rounded bg-gray-100 text-inherit transition not-open:opacity-0 dark:bg-gray-900 starting:opacity-0",
        class="backdrop:bg-black/50 backdrop:backdrop-blur-xs backdrop:transition not-open:backdrop:opacity-0 starting:backdrop:opacity-0"
      )
        div(class="p-4 sm:px-8 sm:py-6")
          form(method="dialog", class="flex justify-end")
            button(
              class="flex rounded p-1 text-gray-600 transition hover:bg-gray-200 hover:text-current dark:text-gray-400 dark:hover:bg-gray-800"
            )
              svg(class="size-5 fill-none stroke-current", viewBox="0 0 24 24")
                title Close
                path(
                  stroke-linecap="round",
                  stroke-linejoin="round",
                  stroke-width="2",
                  d="M6 18L18 6M6 6l12 12"
                )
          include @/components/_contact.pug
