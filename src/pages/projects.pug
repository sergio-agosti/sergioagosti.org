extends @/templates/_layout.pug

block vars
  - var current = "projects";

block meta
  meta(
    name="description",
    content="Selected work by Sergio Agosti: an AI-driven publishing platform built end to end, anonymised client products for insurers, technology and logistics companies, plus personal projects."
  )

block title
  title Sergio Agosti - Projects

mixin tags(list)
  ul(class="flex flex-wrap gap-2")
    each tag in list
      li(class="rounded bg-teal-300 px-2 py-0.5 text-xs text-gray-900 dark:bg-teal-100")= tag

//- Renders `backtick-delimited` spans in project copy as inline code.
mixin prose(text)
  each part, index in String(text).split("`")
    if index % 2
      code= part
    else
      = part

mixin links(list)
  if list && list.length
    ul(class="small flex flex-wrap gap-x-4 gap-y-1")
      each link in list
        li
          a(
            href=link.url,
            class="text-teal-600 underline decoration-teal-600/40 underline-offset-4 transition hover:decoration-current dark:text-teal-400"
          )= link.label

mixin highlights(list)
  ul(class="mt-1 list-disc space-y-1 pl-5 text-gray-600 dark:text-gray-400")
    each point in list
      li: +prose(point)

mixin project(project, options)
  -
    const featured = Boolean(options && options.featured)
    const hasLink = Boolean(project.links && project.links.length)
    const href = hasLink ? project.links[0].url : null
    const linkClass = hasLink
      ? "text-teal-600 dark:text-teal-400 underline decoration-teal-600/40 underline-offset-4 transition hover:decoration-current"
      : false
    const articleClass = featured
      ? "grid gap-2 border-l-4 border-teal-400 pl-4 sm:pl-6"
      : "grid gap-2"
    const titleClass = featured ? "text-xl" : undefined
  article(class=articleClass)
    h3(class=titleClass)
      if href
        a(href=href, class=linkClass)= project.title
      else
        = project.title
    p(class="small text-gray-600 dark:text-gray-400")= project.subtitle
    p= project.summary
    if project.role
      p(class="small text-gray-600 dark:text-gray-400")
        strong(class="font-semibold text-gray-900 dark:text-gray-100") Role:
        = " " + project.role
    if project.highlights
      details(class="small")
        summary(class="cursor-pointer font-semibold") Details
        +highlights(project.highlights)
    p(class="small text-gray-600 dark:text-gray-400")
      = project.era
      if project.note
        small= " · " + project.note
    +tags(project.stack)
    +links(project.links)

block page-header
  h1(class="text-teal-600 transition dark:text-teal-400") Projects
  p(class="text-lg") Client products, websites and personal projects

block content
  section(aria-labelledby="featured-heading", class="space-y-4")
    h2#featured-heading Featured
    div(class="space-y-8")
      each project in PROJECTS.featured
        +project(project, { featured: true })
  section(aria-labelledby="client-heading", class="space-y-4")
    h2#client-heading Client work
    p(class="small text-gray-600 dark:text-gray-400")
      | Built at #[a(href="https://theframeworks.com", class="text-teal-600 underline decoration-teal-600/40 underline-offset-4 transition hover:decoration-current dark:text-teal-400") The Frameworks], most recent first.
      small Clients are anonymised, and some of this work is internal or has since been replaced, so it isn't linkable.
    div(class="space-y-8")
      each project in PROJECTS.client
        +project(project)
  section(aria-labelledby="personal-heading", class="space-y-4")
    h2#personal-heading Personal projects
    div(class="space-y-8")
      each project in PROJECTS.personal
        +project(project)
